# Normalizacion de finales de linea (evita diffs falsos LF/CRLF entre Windows/Linux)
* text=auto eol=lf

# Archivos binarios: nunca normalizar
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.pdf   binary
*.docx  binary
*.xlsx  binary
*.mp4   binary
*.zip   binary

# Scripts y utilidades de Windows: conservar CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf
